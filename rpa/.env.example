# Copie para rpa/.env e preencha. O .env NUNCA vai para o Git (.gitignore).
# Fonte do risco: arquivo local ou URL do site publicado (<URL do site>/data/risco_atual.json)
RISCO_FONTE=../site/public/data/risco_atual.json
ASSINANTES_ARQUIVO=config/assinantes.json
SAIDA_MVP=../site/public/data/alertas.json

# Regras
LIMIAR_FOCOS=100
MAX_ATRASO_DIAS=2
TENTATIVAS=3
ESPERA_S=2

# Telegram (crie o bot com o @BotFather)
TELEGRAM_BOT_TOKEN=

# E-mail (opcional). Gmail: smtp.gmail.com, porta 587, senha de app
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
